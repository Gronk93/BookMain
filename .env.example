# =============================================================================
# BookMind Environment Variables
# =============================================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# PostgreSQL Connection String (optional in development/testing; fallback store active if unset)
# Example: postgresql://postgres:postgres@localhost:5432/bookmind
DATABASE_URL=

# Frontend API Target (Vite dev proxy)
VITE_API_URL=http://localhost:5000

# Private Local Storage Root Directory
BOOKMIND_STORAGE_ROOT=./data/storage

# Maximum PDF Size in Megabytes (default: 100)
MAX_PDF_SIZE_MB=100

# PDF Upload and Processing Timeout in Milliseconds (default: 120000)
PDF_UPLOAD_TIMEOUT_MS=120000
